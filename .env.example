# Copy to .env and fill in. .env is gitignored; never commit real values.
# In CI these are GitHub Actions secrets (docs/architecture-design.md §10).

# --- GCP ------------------------------------------------------------------
# Location is fixed at US multi-region for every dataset and the raw bucket.
# It is immutable after creation — see §14.
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=US
GCP_RAW_BUCKET=olist-raw-your-gcp-project-id
# Path to the service-account key. The file itself must stay out of git.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- BigQuery datasets ----------------------------------------------------
BIGQUERY_RAW_DATASET=olist_raw
BIGQUERY_MARTS_DATASET=olist_marts

# --- Kaggle (source, §4) --------------------------------------------------
# Kaggle issues an API token: kaggle.com/settings -> API -> Create New Token.
# kagglehub reads KAGGLE_API_TOKEN at highest priority. Fill this one.
KAGGLE_API_TOKEN=your-kaggle-api-token
# Legacy alternative, still supported by kagglehub but no longer what the
# settings page hands out. Only needed if you have an old kaggle.json.
# KAGGLE_USERNAME=your-kaggle-username
# KAGGLE_KEY=your-kaggle-api-key

# --- dbt ------------------------------------------------------------------
# The dev target's dataset is fixed in transform/profiles.yml and dbt creates
# it on first build. To keep your work off everyone else's, point GCP_PROJECT
# at your own project rather than renaming the dataset (§10).
DBT_PROFILES_DIR=./transform
# Which profiles.yml target the pipeline builds into. Leave it at dev on a
# laptop; the scheduled run sets prod, whose dataset becomes olist_marts.
DBT_TARGET=dev

# --- Dagster (§8) ---------------------------------------------------------
# Point this at the orchestration/ directory (absolute path) to keep local run
# history between sessions; Dagster stores it as SQLite under
# orchestration/history/, which is gitignored. Leave blank and every run is
# thrown away on process exit. There is no database to provision — see
# orchestration/dagster.yaml.
DAGSTER_HOME=

API_PORT=5001