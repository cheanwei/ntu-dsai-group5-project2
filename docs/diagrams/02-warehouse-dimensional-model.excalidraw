    {
      "id": "note_geo_t",
      "x": 112,
      "y": 1127.5,
      "width": 375.8,
      "height": 105.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1592719,
      "version": 1,
      "versionNonce": 1600638,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "text": "Why no dim_geography\nRaw geolocation is ~1M rows / ~19k zip prefixes.\nint_geolocation_deduped takes the median lat/lng per\nprefix, then the attributes are denormalised into\ndim_customer and dim_seller rather than kept as an\noutrigger: columnar storage compresses the repetition,\nand it removes a join from every geographic query.",
      "originalText": "Why no dim_geography\nRaw geolocation is ~1M rows / ~19k zip prefixes.\nint_geolocation_deduped takes the median lat/lng per\nprefix, then the attributes are denormalised into\ndim_customer and dim_seller rather than kept as an\noutrigger: columnar storage compresses the repetition,\nand it removes a join from every geographic query.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "note_geo",
      "lineHeight": 1.25,
      "autoResize": false
    },
