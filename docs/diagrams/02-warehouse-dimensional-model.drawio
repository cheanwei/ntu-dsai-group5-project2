  <diagram name="Warehouse and Dimensional Model" id="warehouse-and-dimensional-model">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="zl" value="&lt;b&gt;dbt PROJECT LAYERS&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#adb5bd;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#343a40;" vertex="1" parent="1">
          <mxGeometry x="40" y="105" width="1480" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="zs" value="&lt;b&gt;DIMENSIONAL MODEL — olist_marts&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#adb5bd;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#343a40;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1480" height="990" as="geometry"/>
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;Data Warehouse Design  ·  dbt layering + dimensional model (BigQuery)&lt;/b&gt;&lt;br&gt;Fact constellation: fct_order_items is the atomic sales fact; three companion facts share the conformed dimensions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=14;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1480" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;SOURCES  (9)&lt;/b&gt;&lt;br&gt;olist_raw.*&lt;br&gt;dlt-loaded, typed&lt;br&gt;freshness tests" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f0ff;strokeColor=#6741d9;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="70" y="145" width="250" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;STAGING  (9 views)&lt;/b&gt;&lt;br&gt;stg_*&lt;br&gt;1:1 with source&lt;br&gt;rename · cast · dedupe&lt;br&gt;casting lives here only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f0ff;strokeColor=#6741d9;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="360" y="145" width="250" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;INTERMEDIATE  (4 views)&lt;/b&gt;&lt;br&gt;int_*&lt;br&gt;geolocation dedupe&lt;br&gt;order lifecycle pivot&lt;br&gt;payment reconciliation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f0ff;strokeColor=#6741d9;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="650" y="145" width="250" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="l4" value="&lt;b&gt;MARTS  (8 tables)&lt;/b&gt;&lt;br&gt;dim_*  ·  fct_*&lt;br&gt;partitioned + clustered&lt;br&gt;the only layer analysts&lt;br&gt;are expected to query" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ebfbee;strokeColor=#2f9e44;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="940" y="145" width="250" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="l5" value="&lt;b&gt;TESTS&lt;/b&gt;&lt;br&gt;dbt built-ins + dbt-utils&lt;br&gt;dbt-expectations&lt;br&gt;keys · ranges · domains&lt;br&gt;timestamp ordering" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="1230" y="145" width="260" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="dim_date" value="&lt;b&gt;dim_date   852 rows&lt;/b&gt;&lt;br&gt;&lt;br&gt;date_key (PK)  DATE&lt;br&gt;year_number · quarter_number&lt;br&gt;year_month · iso_week_number&lt;br&gt;day_name · is_weekend&lt;br&gt;is_complete_month&lt;br&gt;2016-09-01 → 2018-12-31" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#f08c00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="610" y="345" width="310" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="dim_customer" value="&lt;b&gt;dim_customer   ~96,096 rows&lt;/b&gt;&lt;br&gt;&lt;br&gt;customer_key (PK)&lt;br&gt;  ← customer_unique_id&lt;br&gt;  ⚠ NOT customer_id, which is a&lt;br&gt;  per-order surrogate&lt;br&gt;customer_city · customer_state&lt;br&gt;customer_zip_code_prefix&lt;br&gt;customer_latitude · customer_longitude&lt;br&gt;first/last_order_date · order_count&lt;br&gt;lifetime_revenue · recency_days" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#f08c00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="300" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="fct_order_items" value="&lt;b&gt;fct_order_items    ATOMIC SALES FACT&lt;/b&gt;&lt;br&gt;grain: one order line&lt;br&gt;(order_id + order_item_id) · ~112,650&lt;br&gt;&lt;br&gt;FK  purchase date   → dim_date&lt;br&gt;FK  customer_key    → dim_customer&lt;br&gt;FK  product_key     → dim_product&lt;br&gt;FK  seller_key      → dim_seller&lt;br&gt;DD  order_id · order_item_id&lt;br&gt;&lt;br&gt;price · freight_value&lt;br&gt;line_gross_value = price + freight_value&lt;br&gt;&lt;br&gt;PARTITION BY order_purchase_date&lt;br&gt;CLUSTER BY product_key, seller_key" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="590" y="580" width="350" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="dim_product" value="&lt;b&gt;dim_product   ~32,951 rows&lt;/b&gt;&lt;br&gt;&lt;br&gt;product_key (PK)  ← product_id&lt;br&gt;product_category_name&lt;br&gt;product_category_name_english&lt;br&gt;product_weight_g&lt;br&gt;product_length/height/width_cm&lt;br&gt;product_photos_qty&lt;br&gt;product_name/description_length" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#f08c00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="1130" y="560" width="310" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="dim_seller" value="&lt;b&gt;dim_seller   ~3,095 rows&lt;/b&gt;&lt;br&gt;&lt;br&gt;seller_key (PK)  ← seller_id&lt;br&gt;seller_city · seller_state&lt;br&gt;seller_zip_code_prefix&lt;br&gt;seller_latitude · seller_longitude" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#f08c00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="1130" y="830" width="310" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="fct_orders" value="&lt;b&gt;fct_orders   ACCUMULATING SNAPSHOT&lt;/b&gt;&lt;br&gt;grain: one order · ~99,441&lt;br&gt;&lt;br&gt;FK  order_purchase_date → dim_date&lt;br&gt;FK  customer_key        → dim_customer&lt;br&gt;DD  order_id · order_status&lt;br&gt;&lt;br&gt;item_count · payment_count&lt;br&gt;item_gross_total · payment_value_total&lt;br&gt;payment_difference · reconciled flag&lt;br&gt;approval_days · handover_days&lt;br&gt;delivery_days · estimated_vs_actual_days&lt;br&gt;is_late" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="560" y="920" width="310" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="fct_payments" value="&lt;b&gt;fct_payments&lt;/b&gt;&lt;br&gt;grain: order_id +&lt;br&gt;  payment_sequential · ~103,886&lt;br&gt;&lt;br&gt;DD  order_id  → fct_orders&lt;br&gt;payment_type · installments&lt;br&gt;payment_value&lt;br&gt;&lt;br&gt;⚠ kept separate — joining to&lt;br&gt;order_items fans out revenue" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="140" y="900" width="300" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="fct_reviews" value="&lt;b&gt;fct_reviews&lt;/b&gt;&lt;br&gt;grain: one review · ~99,224&lt;br&gt;&lt;br&gt;DD  order_id  → fct_orders&lt;br&gt;FK  review_creation_date → dim_date&lt;br&gt;review_score (1–5)&lt;br&gt;review_response_days · has_comment&lt;br&gt;&lt;br&gt;⚠ review_id is NOT unique in&lt;br&gt;the source — dedupe in staging" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="960" y="1060" width="300" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="note_geo" value="&lt;b&gt;Why no dim_geography&lt;/b&gt;&lt;br&gt;Raw geolocation is ~1M rows / ~19k zip prefixes.&lt;br&gt;int_geolocation_deduped takes the median lat/lng per&lt;br&gt;prefix, then the attributes are denormalised into&lt;br&gt;dim_customer and dim_seller rather than kept as an&lt;br&gt;outrigger: columnar storage compresses the repetition,&lt;br&gt;and it removes a join from every geographic query." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=10;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="100" y="1110" width="400" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="legend2" value="&lt;b&gt;Solid arrow   = FK to a conformed dimension&lt;/b&gt;&lt;br&gt;Dashed arrow  = degenerate order_id link&lt;br&gt;PK = primary key · FK = foreign key · DD = degenerate&lt;br&gt;&lt;br&gt;Partitioning is ~free at 120 MB; it is declared because&lt;br&gt;the grain and access pattern would demand it at 1000×." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=9;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="520" y="1180" width="380" height="95" as="geometry"/>
        </mxCell>
