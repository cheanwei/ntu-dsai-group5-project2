        <mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#495057;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#495057;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dim_customer" target="fct_order_items">
